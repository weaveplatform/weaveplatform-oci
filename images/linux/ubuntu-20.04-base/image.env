# Ubuntu 20.04 LTS (focal) from Canonical's cloud images (decision 0005,
# cloud-image fallback: Ubuntu has no bootc base). Read by
# scripts/linux/build-cloud-image.sh; plain KEY=value, no shell expansion.
REPOSITORY=ubuntu-20.04-base
VARIANT=base
DISTRO=ubuntu
OS_VERSION=20.04
BASE_URL=https://cloud-images.ubuntu.com/focal
# {arch} is replaced with amd64 or arm64.
MEDIUM=focal-server-cloudimg-{arch}.img
CHECKSUMS=SHA256SUMS
SIGNATURE=SHA256SUMS.gpg
KEYRING=../ubuntu-24.04-base/keys/ubuntu-cloud-image-signing.asc
# UEC Image Automatic Signing Key <cdimage@ubuntu.com>, the key that signs
# every Ubuntu cloud image SHA256SUMS. A different signer is refused.
FINGERPRINTS=D2EB44626FDDC30B513D5BB71A5D6C4C7DB87C81
ARCHES=amd64 arm64
CPU_MIN=1
CPU=2
MEMORY_MIN=1GiB
MEMORY=2GiB
CREDENTIAL_HINT=cloud-init
